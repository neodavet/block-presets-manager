<?xml version="1.0"?>
<ruleset name="Block Presets Manager">
	<description>PHPCS ruleset for the Block Presets Manager plugin.</description>

	<file>.</file>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/bin/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<config name="ignore_warnings_on_exit" value="1"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress">
		<!--
			The main plugin bootstrap file must keep the plugin-slug filename
			(block-presets-manager.php) so WordPress can detect the plugin
			header; it cannot be renamed to class-block-presets-manager.php.
		-->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<!--
			Project convention: inline comments and @param descriptions are not
			required to end in a full stop. Not treated as a style violation here.
		-->
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="block-presets-manager"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="bpmgr_"/>
				<element value="BPMGR_"/>
				<element value="Block_Presets_Manager"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="5.9"/>
</ruleset>
